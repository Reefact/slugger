<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The innermost layer: the theme model, the resolution algorithm, generation,
    formatting and validation.

    It has no ProjectReference and no PackageReference, and that emptiness is the
    point: the dependency rule is enforced by the compiler, not by convention.
    Nothing here is allowed to know about JSON, the file system, the console or
    the clipboard. Slugger.Domain.Tests asserts this stays true.
  -->

</Project>
