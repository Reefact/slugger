<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Adapters: System.Text.Json serialization, the embedded themes, the theme
    directory, the XDG config file, the random sources.

    System.Text.Json ships with the SDK, so this layer still carries zero
    external NuGet dependencies, as the spec requires of the engine.
  -->

  <ItemGroup>
    <ProjectReference Include="..\Slugger.Application\Slugger.Application.csproj" />
  </ItemGroup>

  <ItemGroup Label="Built-in themes - see 'Fourniture des themes' in the spec">
    <EmbeddedResource Include="Resources\slugger.json" LogicalName="Slugger.Themes.slugger.json" />
    <EmbeddedResource Include="Resources\heroku.json" LogicalName="Slugger.Themes.heroku.json" />
    <EmbeddedResource Include="Resources\docker.json" LogicalName="Slugger.Themes.docker.json" />
  </ItemGroup>

</Project>
