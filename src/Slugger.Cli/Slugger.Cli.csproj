<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The executable. The command line, the REPL and oneshot loops, the composition root.

    Every dependency here is one DEC0007 keeps out of Slugger and not out of a command: Spectre
    declares the options once and draws the help from them, TextCopy copies a slug, and neither
    has any meaning inside the engine. ClipboardDependencyTests fails if TextCopy reaches it.

    An XML comment may not carry two dashes in a row, so no flag is spelled out here.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Slugger.Cli</RootNamespace>
    <!-- Not 'slugger': that would collide with the library's Slugger.dll on a
         case-insensitive file system, since a tool package ships both side by side.
         ToolCommandName is what names the command. -->
    <AssemblyName>Slugger.Cli</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>slugger</ToolCommandName>
    <PackageId>Slugger.Cli</PackageId>
    <Description>The slugger command: human-readable random names, Docker- and Heroku-style (humming_dirac, silvery-mud-7643), for containers, git branches and test data. A .NET tool. Not a slugifier.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <!--
    The icon Windows shows for the command. It is compiled into Slugger.Cli.dll as a Win32
    resource, and the executable that runs the tool takes its resources from that assembly.
  -->
  <PropertyGroup>
    <ApplicationIcon>$(MSBuildThisFileDirectory)..\..\assets\slugger.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Slugger\Slugger.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TextCopy" />
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="Spectre.Console.Cli" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Slugger.ArchitectureTests" />
    <InternalsVisibleTo Include="Slugger.Cli.UnitTests" />
  </ItemGroup>

  <!--
    What nuget.org shows on the package page. PACKAGE.md is this package's own page, packed as
    README.md: it sells and links to the documentation on GitHub, so its links are absolute.
  -->
  <PropertyGroup>
    <Title>Slugger CLI: random name generator, Docker and Heroku style</Title>
    <PackageTags>names;name;generator;random;readable;docker;heroku;container;branch;git;petname;haikunator;codename;moniker;cli</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="PACKAGE.md" Pack="true" PackagePath="\README.md" />
    <None Include="$(MSBuildThisFileDirectory)..\..\assets\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
