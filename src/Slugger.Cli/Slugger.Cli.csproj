<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The executable. The command line, the REPL and oneshot loops, the composition root.

    Every dependency here is one DEC0007 keeps out of Slugger and not out of a command: Spectre
    declares the options once and draws the help from them, TextCopy copies a slug, and neither
    has any meaning inside the engine. ClipboardDependencyTests fails if TextCopy reaches it.

    An XML comment may not carry two dashes in a row, so no flag is spelled out here.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Slugger.Cli</RootNamespace>
    <!-- Not 'slugger': that would collide with the library's Slugger.dll on a
         case-insensitive file system, since a tool package ships both side by side.
         ToolCommandName is what names the command. -->
    <AssemblyName>Slugger.Cli</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>slugger</ToolCommandName>
    <PackageId>Slugger.Cli</PackageId>
    <Description>Themed adjective-noun slug generator, as a .NET tool.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Slugger\Slugger.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TextCopy" />
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="Spectre.Console.Cli" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Slugger.ArchitectureTests" />
    <InternalsVisibleTo Include="Slugger.Cli.UnitTests" />
  </ItemGroup>

  <!-- What nuget.org shows on the package page. -->
  <PropertyGroup>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
