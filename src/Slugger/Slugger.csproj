<Project Sdk="Microsoft.NET.Sdk">

  <!--
    One assembly, three namespaces: Domain, Application and Infrastructure are folders here
    rather than projects. The project is small enough that a separate assembly per layer buys
    compiler-enforced isolation at the cost of a package graph nobody needs - the layering is
    a namespace convention, checked by NamespaceDependencyTests rather than by the linker.

    The one split that is kept is this assembly against Slugger.Cli, because it is a real
    packaging boundary: Slugger is what a consumer references, and every dependency it takes
    reaches that consumer.
  -->

  <PropertyGroup>
    <RootNamespace>Slugger</RootNamespace>
    <PackageId>Slugger</PackageId>
    <Description>Human-readable random names, Docker- and Heroku-style (humming_dirac, silvery-mud-7643), drawn from themed JSON word lists in which each adjective only meets the nouns it fits. Not a slugifier.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <!--
    Built-in themes.

    The files on disk stay indented, because a theme has to remain readable and a
    reviewer has to be able to diff one. What gets embedded is minified: 58 357 bytes of JSON
    become 33 648, and Slugger.dll drops from 119 808 to 94 720. The nupkg barely moves - deflate
    was already squeezing the whitespace out - so this buys nothing on download and 25 KB on disk
    and in memory, where the assembly actually sits.
  -->
  <ItemGroup Label="Built-in themes">
    <ThemeSource Include="Infrastructure\Resources\*.json" />
  </ItemGroup>

  <UsingTask TaskName="MinifyThemes"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Sources ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <OutputDirectory ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text" />
      <Code Type="Fragment" Language="cs">
        <![CDATA[
        Directory.CreateDirectory(OutputDirectory);
        foreach (var source in Sources)
        {
            var json = File.ReadAllText(source.ItemSpec);
            var minified = new StringBuilder(json.Length);
            var inString = false;
            var escaped = false;

            // JSON whitespace is insignificant only outside a string, so the copy has to know
            // where it is. A regex cannot: a theme word may hold a space, and it must survive.
            foreach (var character in json)
            {
                if (inString)
                {
                    minified.Append(character);
                    if (escaped) { escaped = false; }
                    else if (character == '\\') { escaped = true; }
                    else if (character == '"') { inString = false; }
                }
                else if (character == '"')
                {
                    inString = true;
                    minified.Append(character);
                }
                else if (character != ' ' && character != '\t' && character != '\r' && character != '\n')
                {
                    minified.Append(character);
                }
            }

            var destination = Path.Combine(OutputDirectory, Path.GetFileName(source.ItemSpec));
            var text = minified.ToString();
            // Written only when it differs, so an untouched theme does not force a rebuild.
            if (!File.Exists(destination) || File.ReadAllText(destination) != text)
            {
                File.WriteAllText(destination, text);
            }
        }
        ]]>
      </Code>
    </Task>
  </UsingTask>

  <Target Name="EmbedMinifiedThemes" BeforeTargets="PrepareForBuild" Inputs="@(ThemeSource)" Outputs="@(ThemeSource -> '$(IntermediateOutputPath)themes/%(Filename)%(Extension)')">
    <MinifyThemes Sources="@(ThemeSource)" OutputDirectory="$(IntermediateOutputPath)themes" />
  </Target>

  <Target Name="AddMinifiedThemes" AfterTargets="EmbedMinifiedThemes" BeforeTargets="PrepareForBuild">
    <ItemGroup>
      <EmbeddedResource Include="$(IntermediateOutputPath)themes/%(ThemeSource.Filename)%(ThemeSource.Extension)"
                        LogicalName="Slugger.Themes.%(ThemeSource.Filename)%(ThemeSource.Extension)" />
    </ItemGroup>
  </Target>

  <!--
    The documentation file a consumer receives describes what a consumer can reach, nothing else.

    The compiler writes a doc comment into Slugger.xml whatever the member's accessibility, so the
    file held some three hundred entries about Application, Infrastructure and the internal helpers
    of Domain - prose about the engine's insides, shipped into every consumer's IntelliSense cache.
    This removes them from the copy in the output directory, which is the one the package and every
    project reference take.

    Accessibility is read from the compiled assembly rather than guessed from a namespace: Domain is
    public, and a namespace filter left 115 internal members of its public types behind (measured).
    MetadataLoadContext reads it without loading the assembly into the build. An inline task is
    compiled against netstandard and cannot name that type, so the task reaches it through
    reflection, from the copy the SDK carries next to MSBuild; everything it hands back is plain
    System.Reflection.

    A member is removed only when the assembly says it is not visible, matched on its whole
    documentation id: an internal overload of a public method shares its name and arity, and only
    the parameter types tell them apart. An id the task cannot match is kept, unless the type
    declaring it is hidden. PublicDocumentationTests reads the result.
  -->
  <UsingTask TaskName="KeepPublicDocumentation"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <Task>
      <Code Type="Class" Language="cs">
        <![CDATA[
        using System;
        using System.Collections.Generic;
        using System.IO;
        using System.Linq;
        using System.Reflection;
        using System.Xml.Linq;
        using Microsoft.Build.Framework;
        using Microsoft.Build.Utilities;

        public sealed class KeepPublicDocumentation : Task
        {
            private const BindingFlags Declared = BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.Instance
                                                | BindingFlags.Static | BindingFlags.DeclaredOnly;

            [Required] public string AssemblyPath { get; set; }
            [Required] public string DocumentationFile { get; set; }
            [Required] public ITaskItem[] References { get; set; }
            [Required] public string ToolsPath { get; set; }

            public override bool Execute()
            {
                string loader = Path.Combine(ToolsPath, "System.Reflection.MetadataLoadContext.dll");
                if (!File.Exists(DocumentationFile)) { return true; }
                if (!File.Exists(loader))
                {
                    Log.LogMessage(MessageImportance.High, "No MetadataLoadContext beside MSBuild: " + DocumentationFile + " keeps its internal members.");
                    return true;
                }

                Assembly metadata = Assembly.LoadFrom(loader);
                Type resolverType = metadata.GetType("System.Reflection.PathAssemblyResolver", true);
                Type contextType = metadata.GetType("System.Reflection.MetadataLoadContext", true);
                List<string> paths = References.Select(reference => reference.ItemSpec).Concat(new[] { AssemblyPath }).ToList();
                object resolver = Activator.CreateInstance(resolverType, new object[] { paths });
                IDisposable context = (IDisposable)Activator.CreateInstance(contextType, new object[] { resolver, null });
                try
                {
                    Assembly assembly = (Assembly)contextType.GetMethod("LoadFromAssemblyPath").Invoke(context, new object[] { AssemblyPath });
                    Type[] every = assembly.GetTypes();
                    Dictionary<string, Type> types = every.ToDictionary(type => type.FullName.Replace('+', '.'));
                    HashSet<string> reachable = new HashSet<string>(StringComparer.Ordinal);
                    HashSet<string> unreachable = new HashSet<string>(StringComparer.Ordinal);
                    foreach (Type type in every)
                    {
                        string typeName = type.FullName.Replace('+', '.');
                        (type.IsVisible ? reachable : unreachable).Add("T:" + typeName);
                        foreach (MemberInfo member in type.GetMembers(Declared))
                        {
                            string id = IdOf(member, typeName);
                            if (id == null) { continue; }

                            (type.IsVisible && IsVisible(member) ? reachable : unreachable).Add(id);
                        }
                    }

                    XDocument documentation = XDocument.Load(DocumentationFile);
                    List<XElement> hidden = documentation.Descendants("member")
                                                         .Where(member => IsHidden((string)member.Attribute("name"), reachable, unreachable, types))
                                                         .ToList();
                    foreach (XElement member in hidden) { member.Remove(); }
                    documentation.Save(DocumentationFile);
                    Log.LogMessage(MessageImportance.Normal, "Removed " + hidden.Count + " internal members from " + DocumentationFile + ".");
                }
                finally
                {
                    context.Dispose();
                }

                return !Log.HasLoggedErrors;
            }

            // Decided on the whole id, parameter types included, since an internal overload can share
            // its name and arity with a public one. An id this task does not spell as the compiler
            // does is kept unless its declaring type is hidden: a leak PublicDocumentationTests
            // reports beats public documentation lost without a word.
            private static bool IsHidden(string id, ISet<string> reachable, ISet<string> unreachable, IDictionary<string, Type> types)
            {
                if (id == null || reachable.Contains(id)) { return false; }
                if (unreachable.Contains(id)) { return true; }

                return DeclaringTypeIsHidden(id, types);
            }

            // A documentation id is a kind, a colon, the declaring type, a dot, the member's name and,
            // for a method or an indexer, its parameters: M:Slugger.Domain.Theme.#ctor(System.String).
            private static bool DeclaringTypeIsHidden(string id, IDictionary<string, Type> types)
            {
                if (id.Length < 3 || id[1] != ':' || id[0] == 'T') { return false; }

                string rest = id.Substring(2);
                int open = rest.IndexOf('(');
                string head = open < 0 ? rest : rest.Substring(0, open);
                int dot = head.LastIndexOf('.');
                if (dot < 0) { return false; }

                Type type;

                return types.TryGetValue(head.Substring(0, dot), out type) && !type.IsVisible;
            }

            private static string IdOf(MemberInfo member, string typeName)
            {
                string name = member.Name.Replace('.', '#').Replace('<', '{').Replace('>', '}');
                MethodBase method = member as MethodBase;
                if (method != null)
                {
                    if (method.IsGenericMethodDefinition) { name += "``" + method.GetGenericArguments().Length; }
                    string id = "M:" + typeName + "." + name + Parameters(method.GetParameters());
                    if (method.Name == "op_Implicit" || method.Name == "op_Explicit") { id += "~" + Spell(((MethodInfo)method).ReturnType); }

                    return id;
                }

                PropertyInfo property = member as PropertyInfo;
                if (property != null) { return "P:" + typeName + "." + name + Parameters(property.GetIndexParameters()); }
                if (member is FieldInfo) { return "F:" + typeName + "." + name; }
                if (member is EventInfo) { return "E:" + typeName + "." + name; }

                return null;
            }

            private static string Parameters(ParameterInfo[] parameters)
            {
                if (parameters.Length == 0) { return ""; }

                return "(" + string.Join(",", parameters.Select(parameter => Spell(parameter.ParameterType))) + ")";
            }

            // A parameter type as a documentation id writes it: a generic argument as `0 for the type's
            // and ``0 for the method's, a constructed type with its arguments in braces, an array as
            // [], a pointer as * and a reference as @.
            private static string Spell(Type type)
            {
                if (type.IsByRef) { return Spell(type.GetElementType()) + "@"; }
                if (type.IsPointer) { return Spell(type.GetElementType()) + "*"; }
                if (type.IsArray)
                {
                    int rank = type.GetArrayRank();
                    string bounds = rank == 1 ? "[]" : "[" + string.Join(",", Enumerable.Repeat("0:", rank)) + "]";

                    return Spell(type.GetElementType()) + bounds;
                }

                if (type.IsGenericParameter) { return (type.DeclaringMethod != null ? "``" : "`") + type.GenericParameterPosition; }

                Type[] arguments = type.IsConstructedGenericType ? type.GetGenericArguments() : Type.EmptyTypes;
                int used = 0;

                return SpellNamed(type, arguments, ref used);
            }

            // A nested type carries the arguments of the types around it first, so each level takes
            // as many as its own arity says and leaves the rest to the next.
            private static string SpellNamed(Type type, Type[] arguments, ref int used)
            {
                string prefix = type.IsNested
                    ? SpellNamed(type.DeclaringType, arguments, ref used) + "."
                    : (string.IsNullOrEmpty(type.Namespace) ? "" : type.Namespace + ".");
                string name = type.Name;
                int tick = name.IndexOf('`');
                if (tick < 0 || arguments.Length == 0) { return prefix + name; }

                int arity = int.Parse(name.Substring(tick + 1));
                string own = string.Join(",", arguments.Skip(used).Take(arity).Select(Spell));
                used += arity;

                return prefix + name.Substring(0, tick) + "{" + own + "}";
            }

            private static bool IsVisible(MemberInfo member)
            {
                MethodBase method = member as MethodBase;
                if (method != null) { return method.IsPublic || method.IsFamily || method.IsFamilyOrAssembly; }
                FieldInfo field = member as FieldInfo;
                if (field != null) { return field.IsPublic || field.IsFamily || field.IsFamilyOrAssembly; }
                PropertyInfo property = member as PropertyInfo;
                if (property != null) { return property.GetAccessors(true).Any(IsVisible); }
                EventInfo handler = member as EventInfo;
                if (handler != null) { return IsVisible(handler.GetAddMethod(true)); }

                return true;
            }
        }
        ]]>
      </Code>
    </Task>
  </UsingTask>

  <Target Name="KeepOnlyPublicDocumentation" AfterTargets="CopyFilesToOutputDirectory" Condition="'@(FinalDocFile)' != ''">
    <KeepPublicDocumentation AssemblyPath="$(TargetPath)"
                             DocumentationFile="@(FinalDocFile->'%(FullPath)')"
                             References="@(ReferencePath)"
                             ToolsPath="$(MSBuildToolsPath)" />
  </Target>

  <ItemGroup>
    <PackageReference Include="FirstClassErrors" />
    <PackageReference Include="Value" />
  </ItemGroup>

  <!--
    Application and Infrastructure are internal: they are how the engine is built, not what it
    offers. The CLI drives them, and the test projects reach in to assert on them; nobody else
    should have to see them in an IntelliSense list, and nothing outside is owed their stability.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="Slugger.Cli" />
    <InternalsVisibleTo Include="Slugger.ArchitectureTests" />
    <InternalsVisibleTo Include="Slugger.UnitTests" />
    <InternalsVisibleTo Include="Slugger.Cli.UnitTests" />
  </ItemGroup>

  <!--
    What nuget.org shows on the package page. PACKAGE.md is this package's own page, packed as
    README.md: it sells and links to the documentation on GitHub, so its links are absolute.
  -->
  <PropertyGroup>
    <Title>Slugger: random name generator, Docker and Heroku style</Title>
    <PackageTags>names;name;generator;random;readable;docker;heroku;container;identifier;petname;haikunator;codename;moniker</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="PACKAGE.md" Pack="true" PackagePath="\README.md" />
    <None Include="$(MSBuildThisFileDirectory)..\..\assets\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
